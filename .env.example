# Environment Configuration

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://proofhire:proofhire_dev@localhost:5432/proofhire_dev

# Separate test database — used by integration tests
DATABASE_TEST_URL=postgresql://proofhire:proofhire_dev@localhost:5432/proofhire_test

# ============================================================
# API SERVER
# ============================================================
# Port for the Express API
API_PORT=4000

# Runtime environment: development | test | production
NODE_ENV=development

# Base URL of the API (used for absolute URL construction in emails, etc.)
API_BASE_URL=http://localhost:4000

# ============================================================
# AUTHENTICATION
# ============================================================
# Random 64+ character secret for session token signing / CSRF
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# Session TTL in seconds (default: 7200 = 2 hours)
SESSION_TTL_SECONDS=7200

# ============================================================
# CORS
# ============================================================
# Origin(s) allowed to make requests to the API
# In development, this is the Vite dev server
CORS_ORIGIN=http://localhost:3000

# ============================================================
# RATE LIMITING
# ============================================================
# Window in milliseconds for auth rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Max login attempts per window per IP
RATE_LIMIT_AUTH_MAX=5

# ============================================================
# EMAIL
# ============================================================
# SMTP configuration for transactional email
# In development, use Mailhog or Mailtrap
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@proofhire.dev
EMAIL_FROM_NAME=ProofHire

# ============================================================
# FILE STORAGE
# ============================================================
# Storage driver: local | s3
FILE_STORAGE_DRIVER=local

# Local storage path (relative to apps/api)
FILE_STORAGE_LOCAL_PATH=./uploads

# S3-compatible storage (only required if FILE_STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Max file upload size in bytes (default: 10MB)
FILE_UPLOAD_MAX_SIZE_BYTES=10485760

# ============================================================
# AI SERVICE
# ============================================================
# URL of the Python AI service
AI_SERVICE_URL=http://localhost:8000

# Internal secret for API→AI service authentication
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET

# Timeout for AI service requests in milliseconds
AI_SERVICE_TIMEOUT_MS=10000

# ============================================================
# LLM PROVIDER (AI Service only)
# ============================================================
# Set ONE of these based on your chosen provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Active provider identifier: openai | anthropic | gemini
LLM_PROVIDER=openai

# Default model to use (provider-specific)
LLM_DEFAULT_MODEL=gpt-4o-mini

# ============================================================
# WEB APP (Vite)
# ============================================================
# These are read by the Vite dev server and baked into the frontend build
# Prefix with VITE_ to expose to the browser
VITE_API_URL=http://localhost:4000
VITE_APP_ENV=development

# ============================================================
# LOGGING
# ============================================================
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ============================================================
# FEATURE FLAGS
# ============================================================
# Enable AI features (set to false to disable AI service calls)
FEATURE_AI_ENABLED=false

# Enable email sending (set to false in development to skip email)
FEATURE_EMAIL_ENABLED=false
