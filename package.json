{
  "name": "proofhire",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-based hiring platform for early-career software developers",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@proofhire/api",
    "dev:web": "npm run dev --workspace=@proofhire/web",
    "db:generate": "npm run db:generate --workspace=@proofhire/api",
    "db:migrate": "npm run db:migrate --workspace=@proofhire/api",
    "db:seed": "npm run db:seed --workspace=@proofhire/api"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
